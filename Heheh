-- Utility: play local sound attached to camera
local function playLocalSound(id, volume, pitch, fadeTime)
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = 0
    s.PlaybackSpeed = pitch or 1
    s.Parent = Camera
    s:Play()
    tween(s, {Volume = volume or 1}, TweenInfo.new(fadeTime or 0.6))
    -- auto cleanup
    spawn(function()
        wait(10)
        if s and s.Parent then
            tween(s, {Volume = 0}, TweenInfo.new(0.6))
            wait(0.7)
            s:Destroy()
        end
    end)
end

-- === 1) FOV TWEEN (slider + button) ===
local fovSlider = Tab:CreateSlider({
    Name = "Camera FOV",
    Range = {10, 120},
    Increment = 1,
    Suffix = "°",
    CurrentValue = 70,
    Flag = "fov_slider",
    Callback = function(val)
        state.fovTarget = val
        if not state.fovTweening then
            state.fovTweening = true
            local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local tweenObj = TweenService:Create(Camera, info, {FieldOfView = val})
            tweenObj:Play()
            tweenObj.Completed:Wait()
            state.fovTweening = false
        else
            -- direct set if tween busy
            Camera.FieldOfView = val
        end
    end
})

Tab:CreateButton({
    Name = "Reset FOV",
    Callback = function()
        fovSlider:Update(70)
        Camera.FieldOfView = 70
    end
})

-- === 2) CAMERA BOB TOGGLE ===
