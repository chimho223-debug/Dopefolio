    Increment = 0.1,
    CurrentValue = 2,
    Callback = function(val) state.bobSpeed = val end
})

-- Bob implementation (RenderStepped)
local bobTick = 0
RunService:BindToRenderStep("CameraBobStep", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if state.cameraBobOn then
        bobTick = bobTick + dt * state.bobSpeed
        local amp = state.bobAmplitude
        local ox = math.sin(bobTick) * amp
        local oy = math.cos(bobTick * 0.9) * amp * 0.6
        local camCFrame = Camera.CFrame
        Camera.CFrame = camCFrame * CFrame.new(ox, oy, 0)
    end
end)

-- === 3) PLAY EMOTE (Animation) ===
local emoteAnimations = {
    ["Wave"] = "rbxassetid://507771019", -- sample short emote anim ids (replace with valid ones)
    ["Cheer"] = "rbxassetid://154859198", 
    ["Point"] = "rbxassetid://251019695"
}
local emoteDropdown = Tab:CreateDropdown({
    Name = "Choose Emote",
    Options = (function()
        local t = {}
        for k,_ in pairs(emoteAnimations) do table.insert(t, k) end
        return t
    end)(),
    CurrentOption = nil,
    Flag = "emote_choice",
    Callback = function(option) end
})

Tab:CreateButton({
    Name = "Play Emote",
    Callback = function()
        if state.emotePlaying then return end
        local choice = emoteDropdown:GetValue() or emoteDropdown.Options[1]
        if not choice then return end
        local animId = emoteAnimations[choice]
        local char = LocalPlayer.Character
        if not char then return end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid then return end

        -- Create animation
        local anim = Instance.new("Animation")
        anim.AnimationId = animId
        local track = humanoid:LoadAnimation(anim)
        state.emotePlaying = true

        -- UI feedback: small tweened label
        local label = Instance.new("TextLabel", screenGui)
        label.Size = UDim2.new(0.3,0,0.06,0)
        label.Position = UDim2.new(0.35,0,0.02,0)
        label.Text = "Playing: "..choice
        label.TextScaled = true
        label.BackgroundTransparency = 0.4
        label.BackgroundColor3 = Color3.fromRGB(30,30,30)
        label.TextColor3 = Color3.new(1,1,1)
        label.BorderSizePixel = 0
        label.Name = "EmoteLabel"
        label.AnchorPoint = Vector2.new(0,0)
        label.ClipsDescendants = true
        tween(label, {Position = UDim2.new(0.35,0,0.02,0), BackgroundTransparency = 0.2}, TweenInfo.new(0.35))

        -- Play
        track:Play()
        track.Stopped:Wait()

        -- cleanup
        tween(label, {BackgroundTransparency = 0.8, Position = UDim2.new(0.35,0,-0.1,0)}, TweenInfo.new(0.35))
        wait(0.4)
        label:Destroy()
        state.emotePlaying = false
    end
})

-- === 4) PARTICLE BURST (local, camera anchored) ===
Tab:CreateButton({
    Name = "Particle Burst",
    Callback = function()
        -- Create particle emitter attached to a small part parented to camera
        local ppart = Instance.new("Part")
        ppart.Size = Vector3.new(0.2,0.2,0.2)
        ppart.Anchored = true
        ppart.CanCollide = false
        ppart.Transparency = 1
        ppart.Parent = effectFolder
        local weld = Instance.new("WeldConstraint", ppart)
        ppart.CFrame = Camera.CFrame * CFrame.new(0,0,-2)

        -- keep position with camera
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if ppart.Parent then
                ppart.CFrame = Camera.CFrame * CFrame.new(0,0,-2)
            else
                conn:Disconnect()
            end
        end)

        local emitter = Instance.new("ParticleEmitter", ppart)
        emitter.Speed = NumberRange.new(4,8)
        emitter.Lifetime = NumberRange.new(0.6,1.2)
        emitter.Rate = 0
        emitter.Rotation = NumberRange.new(0,360)
        emitter.RotSpeed = NumberRange.new(-180,180)
        emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.6), NumberSequenceKeypoint.new(1,0)})
        emitter.Texture = "rbxassetid://243660481" -- generic spark (replace if desired)
        emitter.EmissionDirection = Enum.NormalId.Front
        emitter.SpreadAngle = Vector2.new(180,180)
        emitter.Parent = ppart

        -- burst
        for i=1,20 do
            emitter:Emit(1)
            wait(0.01)
        end

        -- cleanup slowly
        wait(1.5)
        ppart:Destroy()
    end
})

