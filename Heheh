Tab:CreateSlider({
    Name = "Orbit Speed (deg/s)",
    Range = {5,120},
    Increment = 1,
    CurrentValue = 30,
    Callback = function(val) state.orbitRate = val end
})

-- Orbit implementation
local orbitAngle = 0
RunService:BindToRenderStep("CameraOrbitStep", Enum.RenderPriority.Camera.Value + 2, function(dt)
    if state.orbitOn then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local root = char.HumanoidRootPart
            orbitAngle = (orbitAngle + state.orbitRate * dt) % 360
            local radius = 6
            local rad = math.rad(orbitAngle)
            local offset = Vector3.new(math.cos(rad)*radius, 2, math.sin(rad)*radius)
            local target = root.Position + Vector3.new(0,1.5,0)
            Camera.CFrame = CFrame.new(target + offset, target)
        end
    end
end)

